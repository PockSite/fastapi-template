# ===============================
# APP
# ===============================
APP_NAME=PockSite API
# PRODUCTION: true en producción (oculta /api/docs y sube el nivel de logging), false en desarrollo
PRODUCTION=false

# ===============================
# DATABASE
# ===============================
# SQLite en memoria (arranque inmediato, ideal para desarrollo/tests):
DB_URL=sqlite:///:memory:
# Postgres / Supabase (producción):
# DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ===============================
# CORS
# Orígenes permitidos separados por coma (sin espacios entre URLs)
# ===============================
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# ===============================
# SECURITY (opcional; usado por app/core/security.py)
# ===============================
SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
